<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unab_light_bg"
    android:orientation="vertical"
    tools:context=".ui.chat.ChatActivity">

    <!-- TOOLBAR HEADER -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/unab_purple"
            app:title="@string/chat_title"
            app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ACTIVE STUDENT SUBHEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/unab_purple_light"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvActiveStudentInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estudiante: U00010001 - Carlos Gómez"
            android:textColor="@color/unab_purple_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConnectionMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HTTPS n8n Cloud"
            android:textColor="@color/unab_purple"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>

    <!-- LOADING INDICATOR -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/loadingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/unab_yellow"
        app:trackColor="@color/unab_purple_light" />

    <!-- ERROR BANNER -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEE2E2"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No se pudo conectar con el servidor."
            android:textColor="#991B1B"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reintentar"
            android:textColor="#991B1B" />

    </LinearLayout>

    <!-- MESSAGES RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- QUICK PROMPT CHIPS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F3F4F6"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipApproved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aprobadas"
                app:chipBackgroundColor="@color/white"
                app:chipStrokeColor="@color/unab_purple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFailed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reprobadas"
                app:chipBackgroundColor="@color/white"
                app:chipStrokeColor="@color/unab_purple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendientes"
                app:chipBackgroundColor="@color/white"
                app:chipStrokeColor="@color/unab_purple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGPA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promedio"
                app:chipBackgroundColor="@color/white"
                app:chipStrokeColor="@color/unab_purple" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- INPUT BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/chat_input_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:padding="12dp"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/btn_send"
            app:backgroundTint="@color/unab_purple"
            app:cornerRadius="20dp" />

    </LinearLayout>

</LinearLayout>
