<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/unab_light_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- STUDENT PROFILE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/unab_purple"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carlos Gómez"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Código: U00010001"
                    android:textColor="@color/unab_yellow"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStudentProgram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ingeniería de Sistemas - UNAB"
                    android:textColor="#E9D5FF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvStudentProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pensum Activo: PENSUM-DEMO-2024"
                    android:textColor="#E9D5FF"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CHATBOT LAUNCH BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenChat"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="💬 Abrir Chatbot Académico UNAB"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/unab_purple"
            app:cornerRadius="12dp" />

        <!-- QUICK QUESTIONS TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/quick_questions_title"
            android:textColor="@color/unab_dark_grey"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- QUICK QUESTION 1: Approved -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueryApproved"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="¿Qué materias he aprobado?"
            android:textAlignment="viewStart"
            android:textColor="@color/unab_purple"
            app:cornerRadius="8dp"
            app:strokeColor="@color/unab_purple" />

        <!-- QUICK QUESTION 2: Failed -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueryFailed"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="¿Qué materias he reprobado?"
            android:textAlignment="viewStart"
            android:textColor="@color/unab_dark_grey"
            app:cornerRadius="8dp"
            app:strokeColor="@color/unab_card_border" />

        <!-- QUICK QUESTION 3: Pending -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueryPending"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="¿Qué materias tengo pendientes?"
            android:textAlignment="viewStart"
            android:textColor="@color/unab_dark_grey"
            app:cornerRadius="8dp"
            app:strokeColor="@color/unab_card_border" />

        <!-- QUICK QUESTION 4: GPA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQueryGPA"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="¿Cuál es mi promedio acumulado?"
            android:textAlignment="viewStart"
            android:textColor="@color/unab_dark_grey"
            app:cornerRadius="8dp"
            app:strokeColor="@color/unab_card_border" />

        <!-- SWITCH STUDENT BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeStudent"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⇄ Cambiar de Estudiante DEMO"
            android:textColor="@color/unab_purple" />

    </LinearLayout>
</ScrollView>
